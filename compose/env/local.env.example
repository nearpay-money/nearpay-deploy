# Non-secret configuration for the local stack (lld/platform.md §1). scripts/up.sh copies this file to
# local.env on first run; edit local.env, not this file. Secrets live in ../../.secrets (seed.sh keys).

# Hostnames and ports (browsers resolve *.localhost to 127.0.0.1).
NP_BASE_DOMAIN=nearpay.localhost
NP_HTTP_PORT=80
NP_HTTPS_PORT=443
NP_REGISTRY_PORT=4873
NP_LOG_LEVEL=info
# Runtime environment, required by every service (kit 0.2.1 refuses to boot without it). `local` enables the
# development relaxations (virtual operator passkeys, test receipts); never set it on a server.
NP_ENV=local

# Chains and providers (read-only public endpoints; live mode needs owner-provided accounts and keys).
NP_NEAR_RPC_URLS=https://free.rpc.fastnear.com,https://near.drpc.org,https://rpc.mainnet.near.org
NP_NEARDATA_URL=https://mainnet.neardata.xyz
NP_ONECLICK_BASE_URL=https://1click.chaindefuser.com
NP_INTENTS_CONTRACT=intents.near
# Owner-provided for live mode (Stage 1.5); empty means test mode only.
NP_TREASURY_ACCOUNT=
NP_RELAYER_ACCOUNT=
# EVM RPC per chain id (rails destination watchers); empty uses the service default.
NP_EVM_RPC_URLS_1=
NP_EVM_RPC_URLS_8453=
NP_EVM_RPC_URLS_42161=
# Payment confirmation (ADR-0022 as amended 2026-11-10 17:10): one block of each chain's own consensus by default
# (EVM 1 block on every chain incl. Ethereum, Solana `confirmed`, Bitcoin 1 confirmation, NEAR `final`), re-checked
# at finality after success (EVM `finalized`, Solana `finalized`, Bitcoin 6 confirmations; alert on contradiction).
# EVM override per chain id: `finalized` or a block count (empty = 1 block). Solana: `confirmed` (default) | `finalized`.
NP_EVM_CONFIRMATIONS_1=
NP_EVM_CONFIRMATIONS_8453=
NP_EVM_CONFIRMATIONS_42161=
NP_SOLANA_COMMITMENT=confirmed
NP_EXPLORER_ENABLED=false
# Stage 4 Solana RPC / Bitcoin Esplora pools for live mode (rails; sentinel's shared fallback). Empty: rails' public
# defaults (api.mainnet-beta.solana.com; mempool.space + blockstream.info) and no sentinel coverage. Add an
# owner-provided provider URL (>= 2 recommended); sentinel's own accounts go to .secrets/live/ (scripts/seed.sh live).
# Test mode reads the sandbox's simulated chains instead.
NP_SOLANA_RPC_URLS=
NP_BITCOIN_ESPLORA_URLS=
# Checkout's Solana wallet path (live only; build-time, rebuild with up.sh --build-sites). Empty: public mainnet RPC.
NP_CHECKOUT_SOLANA_RPC_URL=

# Stage 4 auto-debit (billing, rails, sandbox). Live: the mainnet vault and the keeper account (gas only; its
# function-call key is .secrets/live/keeper_key, scripts/seed.sh live). Test: the sandbox vault stand-in over
# POST /sim/near-rpc and a generated keeper key (.secrets/keeper_test_key.json, seed.sh keys).
# The vault account you deployed (mainnet checklist B); empty = live auto-debit off.
NP_VAULT_CONTRACT=
NP_KEEPER_ACCOUNT=
NP_TEST_VAULT_CONTRACT=vault.sandbox.near
NP_TEST_KEEPER_ACCOUNT=keeper.sandbox.near
# Vault terms billing prepares (must match the vault's config): USD stablecoins at par (first = default), allowed
# tokens (NEAR USDC, USDT) and the max fee in bps. Empty keeps billing's defaults (the same values).
NP_VAULT_USD_TOKENS=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1,usdt.tether-token.near
NP_VAULT_TOKENS=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1,usdt.tether-token.near
NP_VAULT_MAX_FEE_BPS=500

# Pricing and FX (rails, ADR-0020 d5). Live mode: ECB daily reference rates + CoinGecko keyless prices.
# NP_STABLE_PEGS: non-USD stablecoins at par with their currency, JSON {"<asset_id>":"eur"} (empty: none).
# NP_TEST_FX_RATES: test-mode FX table, JSON {"eur":"1.08",...} USD per unit (empty: the service's fixed table).
NP_PRICING_CURRENCIES=usd,eur,gbp,chf,jpy,cad,aud
NP_STABLE_PEGS=
NP_TEST_FX_RATES=
# Rails observation archive (file store on the rails-obs-archive volume).
NP_OBS_ARCHIVE_STORE=file:/data/obs-archive
NP_OBS_ARCHIVE_AFTER_DAYS=90

# Payment-link checkout sessions per client network / per link + client network / per link (payments §19.1).
NP_LINK_SESSIONS_PER_IP=10
NP_LINK_SESSIONS_PER_LINK_CLIENT=5
NP_LINK_SESSIONS_PER_LINK=600

# Hosted-invoice checkout sessions per minute: per client network / per invoice (billing §6).
NP_PUBLIC_SESSIONS_PER_CLIENT=10
NP_PUBLIC_SESSIONS_PER_INVOICE=30

# Compliance: local screening (OFAC SDN list + blocklist, no vendor; ADR-0020).
NP_SCREENING_PROVIDER=local
# Compliance: daily OFAC SDN download (false offline; then pipe a file to `ops.js sanctions-import -`).
NP_SANCTIONS_REFRESH=true
# Compliance KYB mode (ADR-0024): auto (default) = complete business details go live at once, no NearPay
# approval (geo policy and payout-address sanctions screening stay automatic); manual = ops review in the
# console (Businesses) or `pnpm ops kyb-decide`.
NP_KYB_MODE=auto

# Cloudflare Turnstile test sitekey (always passes; pairs with the test secret seed.sh writes).
NP_TURNSTILE_SITEKEY=1x00000000000000000000AA

# Console (ops.<domain>): operator passkey AAGUID allow-list, relative to compose/ (the local file also allows the
# virtual authenticator, honoured only with NP_ENV=local/test).
NP_OPS_AAGUID_ALLOWLIST_FILE=./identity/ops-aaguids.local.txt

# Payout-wallet activation delay in seconds (identity). 0 = active as soon as attested and approved (default, owner
# decision 2026-11-11); a value > 0 brings back `cooling_off` (the ops CLI `destination-cooloff-skip` ends it locally).
NP_COOLOFF_SECONDS=0
# Sandbox clock (testbed may set 0.1 to run scenarios faster).
NP_SANDBOX_TIME_SCALE=1.0

# Merchant demo network (webhook deliveries may reach only this address through the egress proxy).
NP_DEMO_SUBNET=10.233.250.0/29
NP_DEMO_IP=10.233.250.2
# Dynamic addresses on the demo network (must exclude NP_DEMO_IP).
NP_DEMO_IP_RANGE=10.233.250.4/30
