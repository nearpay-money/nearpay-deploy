# Closed beta at nearpay.money on the owner's Mac (docs/beta-launch.md). Loaded by `scripts/up.sh beta` (and so by
# `scripts/beta.sh`) AFTER compose/env/local.env, so these values win; accounts, RPCs and vault settings stay in
# local.env (mainnet checklist C.1). Owner-specific values the scripts discover (NP_TELEGRAM_CHAT_ID) go to the
# git-ignored .secrets/beta/beta.env, loaded last. Secrets live in .secrets/beta/ and .secrets/live/, never here.

# Real deployment: strict behaviour in every service (kit ENVS: local | server | test). No Turnstile test secrets,
# client IPs from CF-Connecting-IP only, no virtual authenticators, no local-only ops commands.
NP_ENV=server
NP_BASE_DOMAIN=nearpay.money
NP_HTTPS_PORT=443
# Cloudflare terminates TLS; cloudflared is Traefik's only client (compose.beta.yaml, traefik.beta.yaml, routes.yaml).
NP_EDGE=cloudflare
NP_LOG_LEVEL=info

# Payout wallets activate as soon as they are attested and approved: no cool-off (owner decision 2026-11-11, final;
# also identity's default). identity exports nearpay_identity_destination_cooloff_seconds=0; screening, attestation,
# step-up, the approval rule and the activation email still apply.
NP_COOLOFF_SECONDS=0
NP_SANDBOX_TIME_SCALE=1.0
NP_SCREENING_PROVIDER=local
NP_SANCTIONS_REFRESH=true
# Open onboarding (owner decision 2026-11-10, ADR-0024): a merchant's complete business details are decided
# automatically (no NearPay approval); the geo policy still blocks automatically. `manual` turns the console
# review back on without a code change (restart compliance-api and compliance-worker).
NP_KYB_MODE=auto

# Email: Resend SMTP (smtp.resend.com:465, user `resend`, the API key from .secrets/beta/resend_api_key; wiring in
# compose.beta.yaml). The domain is verified in Resend by DNS; no mailbox is needed to send.
NP_FROM="NearPay <receipts@nearpay.money>"
# Replies and the support contact go to the owner's inbox (no @nearpay.money mailbox; optional Cloudflare Email
# Routing support@nearpay.money → this address, docs/beta-launch.md).
NP_REPLY_TO=nearpaydotmoney@gmail.com
# Ops recipients of kill-switch, audit-finding and approval-request mails (notify).
NP_SECURITY_CONTACTS=nearpaydotmoney@gmail.com
# Test-mode payments never mail real customers on a public stack (and they would eat the Resend 100/day cap).
NP_TEST_MODE_RECEIPTS=false
# Resend free plan: 100 mails/day (3,000/month). notify stops at NP_EMAIL_DAILY_CAP and keeps the last
# NP_EMAIL_DAILY_RESERVE of them for security and approval mails (notify beta/public; alerts: EmailCapped, EmailCapLow).
NP_EMAIL_DAILY_CAP=90
NP_EMAIL_DAILY_RESERVE=15

# Console (ops.nearpay.money) sign-in, owner decision 2026-11-09: Google login through Cloudflare Access. identity
# verifies the Cf-Access-Jwt-Assertion at the origin (keys from https://<team domain>/cdn-cgi/access/certs);
# re-authentication = a fresh Access login. The two-person rule is adaptive (needed only with 2+ active operators;
# a single operator's approvals run after identity's default delay and raise the Telegram notice SingleOperatorAction).
NP_OPS_AUTH_MODE=cloudflare_access
# The first operator (ops_admin), enrolled at boot while no operator was ever added.
NP_OPS_BOOTSTRAP_EMAIL=nearpaydotmoney@gmail.com
# OWNER-FILLED (docs/beta-launch.md step 7): leave these empty here. `scripts/beta.sh up` asks for both once and saves
# them in .secrets/beta/beta.env, which is loaded after this file and wins.
#   NP_CF_ACCESS_AUD          Access application > Overview > "Application Audience (AUD) Tag" (64 hex characters)
#   NP_CF_ACCESS_TEAM_DOMAIN  Zero Trust > Settings > Custom Pages: <team>.cloudflareaccess.com (no https://)
NP_CF_ACCESS_AUD=
NP_CF_ACCESS_TEAM_DOMAIN=
# Continue with Google on the merchant dashboard (ADR-0026), optional. OWNER-FILLED (docs/beta-launch.md step 13a):
# the OAuth client id is not a secret — put `NP_GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com` in
# .secrets/beta/beta.env (loaded after this file) and the client secret in .secrets/beta/google_client_secret.
# Empty id or empty secret file = Google sign-in off (the dashboard hides the button); console sign-in is unaffected.
NP_GOOGLE_CLIENT_ID=
# Hardware-key policy for passkey mode, kept wired for a later switch back (NP_OPS_AUTH_MODE=passkey).
NP_OPS_AAGUID_ALLOWLIST_FILE=./identity/ops-aaguids.beta.txt

# cloudflared's fixed address on the tunnel network: the only address Traefik trusts forwarded headers from.
NP_TUNNEL_SUBNET=10.233.251.0/29
NP_TUNNEL_IP=10.233.251.2
NP_TUNNEL_IP_RANGE=10.233.251.4/30

# Monitoring UIs, bound to 127.0.0.1 only.
NP_GRAFANA_PORT=3000
NP_PROMETHEUS_PORT=9090
NP_ALERTMANAGER_PORT=9093
NP_PROMETHEUS_RETENTION=15d
